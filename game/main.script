-- Tiny Consequences: main game object script.
-- Boots the world (worldgen + spin-up in a coroutine behind a loading screen), builds the view,
-- runs the speed controller on the real world tick, routes input (GUI first, then camera /
-- picking), drives the test bridge and the debug overlay.

local sim_version = require("sim.version")
local bridge = require("game.platform.bridge")
local clock = require("game.platform.clock")
local speed = require("game.platform.speed")
local query = require("game.platform.query")
local commands = require("game.platform.commands")
local state = require("game.view.state")
local camera = require("game.view.camera")
local view = require("game.view.view")
local controls = require("game.view.controls")
local uistate = require("game.ui.uistate")
local selection = require("game.ui.selection")

local H_SPACE = hash("key_space")
local H_SHIFT = hash("key_shift")
local H_F3 = hash("key_f3")
local H_M = hash("key_m")   -- (S21: the world's sound on and off)
local POWER_KEYS = {
	[hash("key_1")] = 1, [hash("key_2")] = 2, [hash("key_3")] = 3, [hash("key_4")] = 4,
	[hash("key_5")] = 5, [hash("key_6")] = 6, [hash("key_7")] = 7, [hash("key_8")] = 8,
}
local SPEED_KEYS = {
	[hash("key_1")] = 1, [hash("key_2")] = 2, [hash("key_3")] = 3, [hash("key_4")] = 4,
	[hash("key_5")] = 5, [hash("key_6")] = 6, [hash("key_7")] = 7,
}
local V3_SKIP_KEYS = { [4] = "dawn", [5] = "evening", [6] = "day", [7] = "season" }

local FF_BUDGET_MS = 200       -- run_ticks: sim time per frame while fast-forwarding (tests)
local LOAD_SLICE_MS = 40       -- loading: work per frame before yielding to render a frame
local DEBUG_INTERVAL = 0.25

local URLS = {
	chunk_factory = "/main#chunk_factory",
	deer_factory = "/main#deer_factory",
	wolf_factory = "/main#wolf_factory",
	flame_factory = "/main#flame_factory",
	rain_factory = "/main#rain_factory",
	smoke_factory = "/main#smoke_factory",
	person_factory = "/main#person_factory",
	villager_factory = "/main#villager_factory",
	animal_sheep_factory = "/main#animal_sheep_factory",
	animal_sheep_shorn_factory = "/main#animal_sheep_shorn_factory",
	animal_sheep_dark_factory = "/main#animal_sheep_dark_factory",
	animal_sheep_dark_shorn_factory = "/main#animal_sheep_dark_shorn_factory",
	animal_goat_factory = "/main#animal_goat_factory",
	animal_goat_pied_factory = "/main#animal_goat_pied_factory",
	animal_cow_factory = "/main#animal_cow_factory",
	animal_cow_pied_factory = "/main#animal_cow_pied_factory",
	animal_pig_factory = "/main#animal_pig_factory",
	animal_pig_dark_factory = "/main#animal_pig_dark_factory",
	animal_deer_factory = "/main#animal_deer_factory",
	animal_deer_stag_factory = "/main#animal_deer_stag_factory",
	animal_reindeer_factory = "/main#animal_reindeer_factory",
	animal_antelope_factory = "/main#animal_antelope_factory",
	animal_dog_factory = "/main#animal_dog_factory",
	animal_dog_dark_factory = "/main#animal_dog_dark_factory",
	animal_wolf_factory = "/main#animal_wolf_factory",
	animal_wolf_dark_factory = "/main#animal_wolf_dark_factory",
	tanker_factory = "/main#tanker_factory",
	boat_factory = "/main#boat_factory",
	bird_factory = "/main#bird_factory",
	ring_factory = "/main#ring_factory",
	atmo = "/atmo#mesh",
	terrain = "/terrain#mesh",
}

-- People alive in a v3 world.
local function v3_population(W)
	local n = 0
	for _, p in pairs(W.S.v3.people) do if p.alive then n = n + 1 end end
	return n
end

-- Loading -----------------------------------------------------------------------------------

local function start_loading(self, seed)
	self.seed = seed
	self.W = nil
	self.ready = false
	self.prespun = false
	self.ff = nil
	state.planet_on = false
	state.loading.active = true
	state.loading.frac = 0
	state.loading.text = "Growing a tiny world..."
	self.load_t0 = clock.now_ms()
	self.loader = coroutine.create(function()
		local slice_start = clock.now_ms()
		local function maybe_yield()
			if clock.now_ms() - slice_start > LOAD_SLICE_MS then
				coroutine.yield()
				slice_start = clock.now_ms()
			end
		end
		state.loading.text = "Raising continents..."
		coroutine.yield()
		local W = nil
		if self.use_prespun then
			-- pre-spun Year-0 world (assets/worlds/default.tcsave, custom resource): no spin-up
			self.use_prespun = false
			local ok_mod, worlds = pcall(require, "sim.worlds")
			-- the v3 agent world is the game (D-078, D-079): assets/worlds/v3.tcsave. ?world=v2 loads
			-- the legacy v2 world (assets/worlds/default.tcsave); ?world=NAME any other
			-- assets/worlds/NAME.tcsave (dev: worlds saved later by tools/make_world.lua)
			local wname = query.get().world
			if wname == "v2" then wname = "default" end
			local path = "/assets/worlds/" .. (wname and wname:match("^[%w_]+$") and wname or "v3") .. ".tcsave"
			local okr, data = pcall(sys.load_resource, path)
			if not okr or not data then data = ok_mod and sys.load_resource("/assets/worlds/v3.tcsave") or nil end
			data = ok_mod and data or nil
			if data and worlds.from_save_string then
				state.loading.text = "Unpacking a tiny world..."
				local ok, res, err = pcall(worlds.from_save_string, data)
				if ok and res then
					W = res
					self.seed = W.seed or seed
					self.prespun = true
				else
					bridge.error("pre-spun world failed, generating instead: " .. tostring(ok and err or res))
				end
			end
		end
		if not W then
			-- ?seed=N generates: a v3 agent world, or a v2 world with ?world=v2
			local worldgen = query.get().world == "v2" and require("sim.worldgen.init") or require("sim.agents.worldgen")
			W = worldgen.generate(seed, {
				progress = function(f)
					state.loading.frac = 0.05 + 0.7 * f
					state.loading.text = "Letting the weather settle... " .. math.floor(f * 100) .. "%"
					maybe_yield()
				end,
			})
		end
		state.loading.frac = 0.75
		view.build(W, URLS, function(text, f)
			state.loading.text = text .. "..."
			state.loading.frac = 0.75 + 0.25 * f
			maybe_yield()
		end)
		self.W = W
	end)
end

local function finish_loading(self)
	self.loader = nil
	self.ready = true
	collectgarbage("collect")   -- drop worldgen/view-build garbage behind the loading screen
	state.loading.active = false
	local world = require("sim.world")
	self.perf = self.perf or {}
	-- one hour step (D-050); the planet week runs in the step whose hour starts a UTC week
	self.world_tick_fn = function()
		local W = self.W
		if W.hour % 168 == 0 then
			local a = clock.now_ms()
			world.step(W)
			local p = self.perf
			p.n = (p.n or 0) + 1
			p.ticks[(p.n - 1) % 2048 + 1] = clock.now_ms() - a
		else
			world.step(W)
		end
	end
	self.world_heavy_fn = function() return self.W.hour % 168 == 0 end
	if self.W.v3 then
		speed.v3_init(self.W)
		-- a fresh v3 world opens at its first dawn: the sim lives through the night first (people
		-- sleep, babies wake); ?hour=N (absolute) opens elsewhere
		local qh = query.number("hour", nil)
		if qh or self.W.hour == 0 then
			local to = qh or speed.v3_skip_target(self.W, "dawn")
			if to > self.W.hour then
				require("sim.world").advance(self.W, to)
				speed.v3_t = to
			end
		end
		-- v3 opens at ▶▶ (4 game minutes a second) unless ?speed= says otherwise
		if not query.number("speed", nil) then speed.set(speed.V3_START) end
	else
		speed.v3_t = nil
	end
	self.perf_reset(self)
	-- (S25) a player opens on the whole planet (the title screen over it); the test harnesses keep the village view
	local cam = query.get().cam or (((query.flag("test") or query.flag("skip_intro")) and not query.flag("menu")) and "default" or "title")
	local lat, lon, zoom = camera.preset(cam, self.W)
	if not lat then lat, lon, zoom = camera.preset("default", self.W) end
	camera.set(lat, lon, zoom, true)
	self.tps_tick0, self.tps_t0, self.tps = self.W.tick, clock.now_ms(), 0
	self.load_ms = clock.now_ms() - self.load_t0
	print(string.format("[tc] world %d ready in %.0f ms (%s, %d props, %d chunks)", self.seed,
		self.load_ms, self.prespun and "pre-spun" or "generated", view.stats().prop_total,
		#require("game.view.props").chunks))
end

-- Lifecycle -------------------------------------------------------------------------------

function init(self)
	-- input stack: main first, then the HUD on top (the GUI sees input first and swallows
	-- clicks on its panels)
	msg.post(".", "acquire_input_focus")
	msg.post("/hud", "acquire_input_focus")
	print(string.format("[tc] Tiny Consequences — SIM_VERSION %d, SAVE_VERSION %d",
		sim_version.SIM_VERSION, sim_version.SAVE_VERSION))

	self.frames = 0
	self.ready = false
	self.shift = false
	self.paused_speed = speed.NORMAL
	self.debug_timer = 0
	self.fps, self.fps_frames, self.fps_time = 0, 0, 0
	uistate.debug = query.flag("debug") or query.flag("test")

	local start_speed = query.number("speed", nil)
	if start_speed then
		local ok, err = pcall(speed.set, start_speed)
		if not ok then print("[tc] ignoring ?speed=: " .. tostring(err)) end
	end
	if query.flag("freeze") then view.set_frozen(true) end
	if query.flag("vnoshadow") then state.no_villager_shadow = true end
	-- (S23) ?cloudq=N: the cloud layer's samples fixed (shots compare like with like); else adaptive
	if query.number("cloudq", nil) then require("game.view.clouds").STEPS_FIXED = query.number("cloudq", 24) end
	-- gfx=low: no shadow map and no post pipeline (functional browser tests: headless Chromium
	-- rasterises on the CPU, where the full pipeline costs seconds per frame)
	if query.get().gfx == "low" then
		state.shadow_on = false
		state.post_on = false
		-- (the cloud layer is marched per pixel: work a CPU rasteriser cannot afford - none)
		require("game.view.clouds").DENSITY = 0.45
		require("game.view.clouds").hidden = true
		-- the CPU rasteriser: a thinner forest (the prop placement is the same, fewer slots).
		-- SwiftShader draws ~16 M prop vertices a second: full density is ~2 M at the whole-planet
		-- view (6 fps), two far slots ~0.8 M (probe: gfx {slots_far=N}, 28 Sep)
		local propgen = require("game.view.propgen")
		propgen.SLOTS, propgen.SLOTS_FAR = 8, 2
		require("game.view.puppets").BIRD_ZOOM = 99
	end

	self.start_loading = start_loading
	-- W08 performance accumulators (per-tick ms ring, per-frame sim/view ms)
	self.perf_reset = function(s)
		s.perf = { n = 0, ticks = {}, frames = 0, sim_sum = 0, sim_max = 0, view_sum = 0, view = {}, multi = 0, multi_over = 0,
			t0 = clock.now_ms(), tick0 = s.W and s.W.tick or 0 }
	end
	self.perf_reset(self)
	bridge.init()
	commands.register(self)
	bridge.set_provider(function()
		local avg, max = speed.stats()
		local W = self.W
		local vs = view.stats()
		local sel = selection.sel
		return {
			ready = self.ready,
			loading = state.loading.active,
			loading_frac = state.loading.frac,
			seed = self.seed,
			tick = W and W.tick or 0,
			hour = W and (W.v3 and speed.v3_t or W.hour) or 0,
			hour_f = W and (W.v3 and speed.v3_t or (W.hour + speed.alpha())) or 0,
			year = W and math.floor(W.hour / 8064) or 0,
			speed = speed.get(),
			v3 = W and W.v3 or false,
			skipping = speed.v3_skipping(),
			skip_progress = speed.v3_skip_progress() or false,
			skip_done = speed.skip_done or false,
			frame_gap_ms = self.f_gap or 0, frame_update_ms = self.f_upd or 0, frame_bridge_ms = self.f_bridge or 0,
			ticks_per_s = self.tps or 0,
			sim_ms_avg = avg,
			sim_ms_max = max,
			view_ms = vs.view_ms,
			view_ms_max = vs.view_ms_max,
			view_ms_avg = vs.view_ms_avg,
			view_ms_p90 = vs.view_ms_p90,
			view_parts = vs.view_parts,
			lua_kb = math.floor(collectgarbage("count")),
			prop_count = vs.prop_count,
			prop_total = vs.prop_total,
			prop_verts = vs.prop_verts,
			draw_calls = vs.draw_calls,
			chunks_rebuilt = vs.chunks_rebuilt,
			chunks_visible = vs.chunks_visible,
			chunks_dirty = vs.chunks_dirty,
			clouds = vs.clouds,
			cloud_cover = vs.cloud_cover,
			fires = vs.fires,
			puppets = vs.puppets,
			people_puppets = vs.people_puppets,
			ships = vs.ships,
			cam = vs.cam,
			frozen = state.frozen,
			selection = sel and { kind = sel.kind, cell = sel.cell, id = sel.id } or false,
			population = W and (W.v3 and v3_population(W) or require("game.view.ents").population(W)) or 0,
			villages = W and (W.v3 and #W.S.v3.settlements or #require("game.view.ents").villages(W)) or 0,
			events = W and W.E and W.E.total or 0,
			last_power = (function()
				if not (W and W.E) then return "" end
				local o = W.E.order
				for k = #o, math.max(1, #o - 200), -1 do
					local r = W.E.rec[o[k]]
					if r and r.parent == 0 and r.kind:sub(1, 6) == "power_" then return r.kind .. "#" .. r.id end
				end
				return ""
			end)(),
			ff_remaining = self.ff and (self.ff.target - W.tick) or 0,
			last_input = self.last_input or false,
			sim_version = sim_version.SIM_VERSION,
			engine_debug = sys.get_engine_info().is_debug,
			prespun = self.prespun or false,
			load_ms = self.load_ms or 0,
		}
	end)

	-- default start: the pre-spun world when it ships; ?seed=N always generates
	self.use_prespun = query.get().seed == nil
	start_loading(self, query.number("seed", 1))
end

local function update_debug(self, dt)
	self.fps_frames = self.fps_frames + 1
	self.fps_time = self.fps_time + dt
	if self.fps_time >= 0.5 then
		self.fps = self.fps_frames / self.fps_time
		self.fps_frames, self.fps_time = 0, 0
	end
	if self.ready then
		local now = clock.now_ms()
		if now - self.tps_t0 >= 1000 then
			self.tps = (self.W.tick - self.tps_tick0) * 1000 / (now - self.tps_t0)
			self.tps_tick0, self.tps_t0 = self.W.tick, now
		end
	end
	if not uistate.debug then return end
	self.debug_timer = self.debug_timer + dt
	if self.debug_timer < DEBUG_INTERVAL then return end
	self.debug_timer = 0
	local avg, max = speed.stats()
	local s = view.stats()
	uistate.debug_lines = string.format(
		"fps %.0f   speed %d   ticks/s %.1f   tick %d\n" ..
		"sim %.2f ms avg / %.2f max per frame\n" ..
		"view %.2f ms (p90 %.2f)   draw calls ~%d\n" ..
		"props %d visible / %d total   chunks %d (rebuilt %d)\n" ..
		"clouds %d   movers %d   fires %d   events %d\n" ..
		"Lua heap %.1f MB",
		self.fps, speed.get(), self.tps or 0, self.W and self.W.tick or 0,
		avg, max, s.view_ms or 0, s.view_ms_p90 or 0, s.draw_calls,
		s.prop_count, s.prop_total, s.chunks_visible, s.chunks_rebuilt,
		s.clouds, s.puppets, s.fires, self.W and self.W.E and self.W.E.total or 0,
		collectgarbage("count") / 1024)
end

function update(self, dt)
	-- frame timing (probes): the gap between frames and the time this script's update takes
	local fa = clock.now_ms()
	if self.f_last then
		local gap = fa - self.f_last
		self.f_gap = (self.f_gap or gap) + (gap - (self.f_gap or gap)) * 0.1
	end
	self.f_last = fa
	if self.loader then
		local ok, err = coroutine.resume(self.loader)
		if not ok then
			bridge.error("loading: " .. tostring(err))
			self.loader = nil
			state.loading.text = "Something went wrong :("
		elseif coroutine.status(self.loader) == "dead" then
			finish_loading(self)
		end
	elseif self.ready then
		local W = self.W
		if self.ff then
			local t0 = clock.now_ms()
			local world = require("sim.world")
			while W.tick < self.ff.target and clock.now_ms() - t0 < FF_BUDGET_MS do
				world.tick(W)
			end
			if W.tick >= self.ff.target then
				print(string.format("[tc] run_ticks done at tick %d (%.0f ms)", W.tick, clock.now_ms() - self.ff.t0))
				self.ff = nil
				bridge.publish()
			end
		elseif W.v3 then
			speed.step_v3(dt, W, require("sim.world"))
		else
			speed.step(dt, self.world_tick_fn, self.world_heavy_fn)
			local _, _, frame_ms, frame_ticks = speed.stats()
			local p = self.perf
			p.frames = p.frames + 1
			p.sim_sum = p.sim_sum + frame_ms
			if frame_ms > p.sim_max then p.sim_max = frame_ms end
			-- the controller's contract: a frame that ran several ticks stays within its budget
			-- (one tick may exceed it on a slow frame: the sim must still advance)
			if frame_ticks >= 2 then
				p.multi = p.multi + 1
				if frame_ms > speed.SIM_BUDGET_MS[speed.get()] + 1 then p.multi_over = p.multi_over + 1 end
			end
		end
		-- GUI requests
		local r = uistate.pop_request()
		while r do
			if r.cmd == "fly_to_sel" then controls.fly_to_selection(W) end
			if r.cmd == "follow" then require("game.view.agents_view").follow = r.id end
			r = uistate.pop_request()
		end
	end

	controls.tick(dt)
	require("game.ui.powers").tick(dt)
	-- (S25) a skip seen from above: the camera rises, the planet turns through its days, then back down
	if self.ready and self.W and self.W.v3 and (not query.flag("test") or query.flag("menu")) then require("game.view.skipcam").update(dt) end
	view.update(dt)
	if self.ready and self.perf then
		local p = self.perf
		p.view_sum = p.view_sum + view.view_ms
		p.view[(p.frames - 1) % 2048 + 1] = view.view_ms
	end
	update_debug(self, dt)

	self.frames = self.frames + 1
	local fu = clock.now_ms() - fa
	self.f_upd = (self.f_upd or fu) + (fu - (self.f_upd or fu)) * 0.1
	bridge.update(dt)
	self.f_bridge = clock.now_ms() - fa - fu
end

function on_input(self, action_id, action)
	if action_id ~= nil then
		self.input_count = (self.input_count or 0) + 1
		self.last_input = { id = tostring(action_id), pressed = action.pressed, released = action.released,
			x = action.screen_x, y = action.screen_y, n = self.input_count }
	end
	if action_id == H_SHIFT then
		if action.pressed then self.shift = true elseif action.released then self.shift = false end
		return false
	end
	if self.ready and not self.shift then
		if controls.on_input(self.W, action_id, action) then return true end
	end
	if action_id == nil then return false end
	if not action.pressed then
		return false
	end
	if action_id == H_SPACE then
		if speed.v3_skipping() then
			speed.v3_skip_cancel()
		elseif speed.get() == speed.PAUSE then
			speed.set(self.paused_speed)
		else
			self.paused_speed = speed.get()
			speed.set(speed.PAUSE)
		end
		return true
	elseif action_id == H_F3 then
		uistate.debug = not uistate.debug
		return true
	elseif action_id == H_M then
		local audio = require("game.audio.audio")
		audio.ON = not audio.ON
		return true
	end
	if self.shift and self.ready and POWER_KEYS[action_id] then
		-- Shift+1..8: arm a power (04 §2)
		local powers = require("game.ui.powers")
		local n = POWER_KEYS[action_id]
		if powers.DEFS[n] then powers.arm(n) end
		return true
	end
	local lvl = SPEED_KEYS[action_id]
	if lvl and not self.shift then
		if self.W and self.W.v3 and lvl > speed.V3_WATCH_MAX then
			-- v3: 4 dawn, 5 evening, 6 a day, 7 the next season (explicit skips, D-079)
			if speed.v3_skipping() then speed.v3_skip_cancel() else speed.v3_skip(self.W, V3_SKIP_KEYS[lvl]) end
		else
			if speed.v3_skipping() then speed.v3_skip_cancel() end
			if lvl <= speed.MAX_LEVEL then speed.set(lvl) end
		end
		return true
	end
	return false
end

#version 140
// Clouds v5 (S23) in the sun's shadow pass: a sphere at the cloud layer's height, drawn from the sun (the
// render script's light view and projection); cloudshell.fp writes the layer's cover into the shadow
// map's alpha (soft cloud shadows on the ground, game/render/shaders/shadow.glsl).
in highp vec4 position;

uniform vs_uniforms
{
    highp mat4 view_proj;
};

out highp vec3 var_p;

void main()
{
    var_p = position.xyz;
    gl_Position = view_proj * vec4(position.xyz, 1.0);
}

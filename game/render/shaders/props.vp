#version 140
// Batched static props (chunk meshes, renderer v4 "instanced bake", D-056). Each vertex carries
// its template's local position/normal/attributes (copied natively from the template buffer with
// buffer.copy_buffer) and its instance's data (origin, yaw, scale, cell, colours), so the chunk
// is baked at native speed and the instance transform happens here. Each vertex knows its sim
// cell and material class (propgen.lua), so the props follow the living world without
// rebuilding: deciduous crowns turn gold and red in autumn (each tree on its own schedule), go
// bare in winter and blossom in spring (by the local season: the south is half a year off),
// grass and flowers brown in droughts and cold, snow settles on roofs, conifers and rocks, fires
// glow.

in highp vec4 position;   // template-local position
in mediump vec3 normal;   // template-local normal
in highp vec4 tattr;      // slot, shade (0.5..1), sway (0..1), fixed rgb (slots >= 4) or tint (-1..1)
in highp vec4 inst;       // origin (planet space), yaw
in highp vec4 inst2;      // scale, height scale, sim cell id, classes (c1 + 8 c2 + 64 c3)
in highp vec4 inst3;      // packed rgb of slots 1..3, per-instance random 0..1

uniform highp sampler2D celltex;

uniform vs_uniforms
{
    highp mat4 mtx_world;
    highp mat4 mtx_view;
    highp mat4 mtx_proj;
    highp vec4 u_anim;   // x = time, y = sway strength, z = tick of year (0..48), w = seasons on
    highp vec4 u_tex;    // x = 1 / texture height, y = texture width (cells), z = texture height
    highp vec4 u_sh0;
    highp vec4 u_sh1;
    highp vec4 u_sh2;
    highp vec4 u_shn;
};

out highp vec3 var_wpos;
out mediump vec3 var_normal;
out mediump vec3 var_color;
out highp vec3 var_sc;
out mediump vec3 var_mat;   // x = snow cover for this surface, y = fire, z = class
out mediump float var_bare; // deciduous foliage gone (winter): the fragment shader thins it out

vec3 unpack_rgb(float p)
{
    float v = floor(p + 0.5);
    float b = mod(v, 128.0);
    v = floor(v / 128.0);
    float g = mod(v, 128.0);
    float r = floor(v / 128.0);
    return vec3(r, g, b) / 127.0;
}

void main()
{
    // instance frame: up = radial, east/north from the up vector, turned by the yaw
    vec3 O = inst.xyz;
    vec3 U = normalize(O);
    vec3 T = vec3(U.z, 0.0, -U.x);
    float tl = length(T);
    T = tl < 1e-4 ? vec3(1.0, 0.0, 0.0) : T / tl;
    vec3 Bv = vec3(-T.z * U.y, T.z * U.x - T.x * U.z, T.x * U.y);
    float cy = cos(inst.w);
    float sy = sin(inst.w);
    vec3 E = T * cy + Bv * sy;
    vec3 Fv = Bv * cy - T * sy;
    vec3 lp = position.xyz * vec3(inst2.x, inst2.y, inst2.x);
    vec3 pos = O + E * lp.x + U * lp.y + Fv * lp.z;
    vec3 nrm = E * normal.x + U * normal.y + Fv * normal.z;

    // colour by slot: instance colours for slots 1..3 (with the template's per-lump tint),
    // fixed colours for the rest
    float slot = floor(tattr.x + 0.5);
    float cls = 0.0;
    vec3 col;
    float cl = floor(inst2.w + 0.5);
    if (slot < 3.5) {
        float pc = slot < 1.5 ? inst3.x : (slot < 2.5 ? inst3.y : inst3.z);
        if (pc < 0.5) pc = inst3.x;
        col = unpack_rgb(pc);
        cls = slot < 1.5 ? mod(cl, 8.0) : (slot < 2.5 ? mod(floor(cl / 8.0), 8.0) : floor(cl / 64.0));
        // per-lump tint: sunlit lumps lean yellow-green, deep ones blue-green
        float tint = tattr.w;
        col *= 1.0 + tint * vec3(0.10, 0.07, -0.06);
        col = mix(col, col * vec3(0.82, 0.95, 1.08), max(-tint, 0.0) * 0.6);
    } else {
        col = unpack_rgb(tattr.w);
        cls = abs(slot - 6.0) < 0.5 ? 6.0 : 0.0;
    }
    float sway = tattr.z;
    float shade = tattr.y;
    float rnd = inst3.w;
    // (rnd > 1.5 flags a glowing instance: a window lit by the hearth inside, D-082)
    float glow = 0.0;
    if (rnd > 1.5) { rnd -= 2.0; glow = 1.0; }

    vec4 wp = mtx_world * vec4(pos, 1.0);
    vec3 up = U;
    vec3 east = normalize(cross(vec3(0.0, 1.0, 0.0), up) + vec3(0.0001, 0.0, 0.0));
    float ph = dot(O, vec3(3.1, 1.7, 2.3)) + rnd * 6.0;
    wp.xyz += east * (sin(u_anim.x * 1.7 + ph) + 0.4 * sin(u_anim.x * 3.1 + ph * 1.7)) * 0.006 * sway * u_anim.y;

    float snow = 0.0;
    float fire = 0.0;
    float bare = 0.0;
    // (S24, D-190) a village map's own props carry their cell negated: they burn one by one (their flames are drawn
    // where each burns, game/view/fx.lua), never by the cell's fire - the cell's colour, season and snow still apply
    float zc = abs(inst2.z);
    bool vmap = inst2.z < -0.5;
    if (zc > 0.5 && u_anim.w > 0.5) {
        float id = floor(zc + 0.5) - 1.0;
        float tx = mod(id, u_tex.y);
        float ty = floor(id / u_tex.y) * 4.0;
        vec2 uv = vec2((tx + 0.5) / u_tex.y, (ty + 0.5) * u_tex.x);
        vec4 A = textureLod(celltex, uv, 0.0);
        vec4 B = textureLod(celltex, uv + vec2(0.0, u_tex.x), 0.0);
        vec4 D = textureLod(celltex, uv + vec2(0.0, 3.0 * u_tex.x), 0.0);
        float temp = D.r * 70.0 - 30.0;
        snow = smoothstep(0.2, 0.65, A.a);
        fire = vmap ? 0.0 : B.r;
        // each tree keeps its own calendar (a week or two early or late)
        float toy = mod(u_anim.z + (wp.y < 0.0 ? 24.0 : 0.0) + (rnd - 0.5) * 3.0, 48.0);
        // no seasons in the tropics: the colour year fades out toward the equator
        float seasonal = smoothstep(0.18, 0.42, abs(up.y));
        float hv = fract(rnd * 7.13 + sin(dot(floor(position.xyz * 23.0), vec3(12.9898, 78.233, 37.719))) * 0.35);
        if (cls == 1.0) {
            // deciduous foliage through the year: species tint their autumn by their base colour
            float autumn = smoothstep(23.0, 29.0, toy) * (1.0 - smoothstep(41.0, 45.0, toy));
            autumn *= 1.0 - smoothstep(9.0, 20.0, temp);
            vec3 aut = mix(vec3(0.95, 0.63, 0.16), vec3(0.86, 0.32, 0.13), fract(rnd * 3.7));
            aut = mix(aut, vec3(0.97, 0.82, 0.26), step(0.62, fract(rnd * 5.3 + hv * 0.3)));
            autumn *= seasonal;
            col = mix(col, aut, autumn * 0.92);
            float winter = clamp(smoothstep(35.0, 39.0, toy) + 1.0 - smoothstep(1.0, 5.0, toy), 0.0, 1.0);
            winter *= (1.0 - smoothstep(2.0, 9.0, temp)) * seasonal;
            col = mix(col, vec3(0.50, 0.42, 0.36), winter * 0.85);
            // leaf fall: late autumn thins the crowns, winter leaves the branches bare
            float leafless = clamp(smoothstep(32.0, 37.0, toy) + 1.0 - smoothstep(3.0, 8.0, toy), 0.0, 1.0);
            bare = leafless * (1.0 - smoothstep(4.0, 11.0, temp)) * seasonal * 0.88;
            float spring = smoothstep(2.0, 5.0, toy) * (1.0 - smoothstep(9.0, 13.0, toy)) * seasonal;
            col = mix(col, vec3(0.99, 0.88, 0.92), spring * step(0.84, hv) * smoothstep(3.0, 9.0, temp) * 0.85);
            col = mix(col, col * vec3(1.06, 1.14, 0.82), spring * 0.45);
            snow *= 0.45;
        } else if (cls == 4.0) {
            // the snow caps of snowy conifers only show when there is snow
            col = mix(vec3(0.19, 0.42, 0.28), col, snow);
            snow = 0.0;
        } else if (cls == 7.0) {
            float brown = max(B.b, 1.0 - smoothstep(-1.0, 7.0, temp));
            col = mix(col, vec3(0.76, 0.66, 0.40), brown * 0.75);
            snow = smoothstep(0.1, 0.4, A.a);
        } else if (cls == 3.0) {
            col = mix(col, vec3(0.72, 0.66, 0.36), B.b * 0.6);
            snow *= 0.5;
        } else if (cls == 2.0) {
            // evergreens darken a little in winter
            float winter = clamp(smoothstep(35.0, 39.0, toy) + 1.0 - smoothstep(1.0, 5.0, toy), 0.0, 1.0) * seasonal;
            col *= mix(1.0, 0.86, winter * (1.0 - smoothstep(0.0, 8.0, temp)));
        }
    }
    var_mat = vec3(snow, fire, cls);
    var_bare = glow > 0.5 ? -1.0 : bare;
    var_wpos = wp.xyz;
    var_normal = normalize(mat3(mtx_world) * nrm);
    var_color = col * shade;
    highp vec3 sp = wp.xyz + var_normal * u_shn.x;
    var_sc = vec3(dot(u_sh0, vec4(sp, 1.0)), dot(u_sh1, vec4(sp, 1.0)), dot(u_sh2, vec4(sp, 1.0)));
    gl_Position = mtx_proj * mtx_view * wp;
}

#version 140
// Shadow pass (local-space meshes: terrain, prop chunks): light view/projection set by the
// render script, so mtx_view/mtx_proj are the sun's.
in highp vec4 position;

uniform vs_uniforms
{
    highp mat4 mtx_world;
    highp mat4 mtx_view;
    highp mat4 mtx_proj;
};

void main()
{
    gl_Position = mtx_proj * mtx_view * mtx_world * vec4(position.xyz, 1.0);
}

#version 140
// Terrain + sea surface in one mesh (renderer v2, D-048). Per-vertex sim-cell data comes from
// the cell data texture (3 texels per sim cell; see game/view/cellcolor.lua), blended over the
// 3 sim cells of the vertex's sim triangle, so colour updates never touch the vertex buffer.

in highp vec4 position;
in mediump vec3 normal;
in highp vec4 cella;   // uv of cell a, uv of cell b
in highp vec4 cellc;   // uv of cell c, weight a, weight b
in highp vec4 vinfo;   // height km (negative = depth), noise, 0, coast field (>0 land)

uniform highp sampler2D celltex;

uniform vs_uniforms
{
    highp mat4 mtx_world;
    highp mat4 mtx_view;
    highp mat4 mtx_proj;
    highp vec4 u_tex;  // x = texel height (offset to a cell's next texel row)
    highp vec4 u_sh0;  // shadow matrix rows (bias * sun proj * sun view)
    highp vec4 u_sh1;
    highp vec4 u_sh2;
    highp vec4 u_shn;  // x = normal offset (world units)
};

out highp vec3 var_wpos;
out mediump vec3 var_normal;
out mediump vec4 var_land;   // ground rgb + snow (land); shore sand (water side)
out mediump vec4 var_fx;     // r fire (land), g oil, b plankton (water), a ice/snow (both)
out mediump vec4 var_fx2;    // land: ash, dryness, grass, 0     water: 0, 0, 0, fish
out mediump vec4 var_farm;   // land: farm, crop stage, village, forest
out highp vec4 var_info;
out highp vec3 var_sc;

vec4 cellmix(vec2 dv, float wa, float wb, float wc)
{
    return textureLod(celltex, cella.xy + dv, 0.0) * wa
         + textureLod(celltex, cella.zw + dv, 0.0) * wb
         + textureLod(celltex, cellc.xy + dv, 0.0) * wc;
}

void main()
{
    vec4 wp = mtx_world * vec4(position.xyz, 1.0);
    var_wpos = wp.xyz;
    var_normal = normalize(mat3(mtx_world) * normal);
    float wa = cellc.z;
    float wb = cellc.w;
    float wc = max(0.0, 1.0 - wa - wb);
    vec4 A = cellmix(vec2(0.0), wa, wb, wc);
    vec4 B = cellmix(vec2(0.0, u_tex.x), wa, wb, wc);
    vec4 C = cellmix(vec2(0.0, 2.0 * u_tex.x), wa, wb, wc);
    // Each channel means one thing on both sides of a coast: triangles that straddle it
    // interpolate between a land and a water vertex (sea ice once bled into land as "fire").
    if (vinfo.w > 0.0) {
        var_land = A;
        var_fx = vec4(B.r, 0.0, 0.0, A.a);
        var_fx2 = vec4(B.g, B.b, B.a, 0.0);
        var_farm = C;
    } else {
        var_land = vec4(0.95, 0.88, 0.66, 0.0);   // shore sand for the land side of coasts
        var_fx = vec4(0.0, B.g, B.b, A.a);
        var_fx2 = vec4(0.0, 0.0, 0.0, B.a);
        var_farm = vec4(0.0);
    }
    var_info = vinfo;
    highp vec3 sp = wp.xyz + var_normal * u_shn.x;
    var_sc = vec3(dot(u_sh0, vec4(sp, 1.0)), dot(u_sh1, vec4(sp, 1.0)), dot(u_sh2, vec4(sp, 1.0)));
    gl_Position = mtx_proj * mtx_view * wp;
}

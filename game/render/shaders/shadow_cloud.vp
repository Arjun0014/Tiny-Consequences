#version 140
// Cloud puffs in the sun's shadow pass (see cloud.vp): the same drift and life, a soft disc of
// cover facing the light (the render script adds the cover into the shadow map's alpha).
in highp vec4 position;
in mediump vec3 normal;
in highp vec4 puff;
in highp vec4 puff2;
in highp vec4 puff3;

uniform vs_uniforms
{
    highp mat4 view_proj;
    highp mat4 mtx_view;
    highp vec4 u_cloud;
};

out mediump vec3 var_disc;   // xy: position in the disc (1 = rim), z: cover

void main()
{
    float hour = u_cloud.x;
    float F = max(0.01, min(u_cloud.y, (puff3.y - puff3.x) * 0.25));
    float life = smoothstep(puff3.x, puff3.x + F, hour) * (1.0 - smoothstep(puff3.y - F, puff3.y, hour));
    vec3 c = position.xyz;
    float a = puff2.z * (hour - puff3.x);
    float ca = cos(a);
    float sa = sin(a);
    c = vec3(c.x * ca - c.z * sa, c.y, c.x * sa + c.z * ca);
    float r = puff.z * (0.3 + 0.7 * life);
    vec3 right = vec3(mtx_view[0][0], mtx_view[1][0], mtx_view[2][0]);
    vec3 vup = vec3(mtx_view[0][1], mtx_view[1][1], mtx_view[2][1]);
    vec3 wp = c + (right * puff.x + vup * puff.y) * r;
    var_disc = vec3(puff.x, puff.y, puff2.w * life * mix(0.55, 0.85, puff3.z));
    gl_Position = life > 0.002 ? view_proj * vec4(wp, 1.0) : vec4(2.0, 2.0, 2.0, 1.0);
}

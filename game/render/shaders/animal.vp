#version 140
// v3 animals (roadmap v3 R3; docs/v3/20_CHARACTER_PIPELINE.md §4): the CC0 Quaternius farm animals,
// GPU-skinned and instanced (assets/animals/*.glb, built by tools/blender/build_animals.py). Each
// vertex's colour is baked into its uv.x (7 bits a channel: (r * 16384 + g * 128 + b + 0.5) / 2^21),
// so there are no per-instance constants and every animal of one variant and LOD is one instanced
// draw. Lighting and shadows come from props.fp (the same sun, shade and fog as the planet's props).
in highp vec4 position;
in highp vec2 texcoord0;
in mediump vec3 normal;
in mediump vec4 bone_weights;
in mediump vec4 bone_indices;
in highp mat4 mtx_world;
in mediump mat4 mtx_normal;
in highp vec4 animation_data;

uniform vs_uniforms
{
    highp mat4 mtx_view;
    highp mat4 mtx_proj;
    highp vec4 u_sh0;
    highp vec4 u_sh1;
    highp vec4 u_sh2;
    highp vec4 u_shn;
};

out highp vec3 var_wpos;
out mediump vec3 var_normal;
out mediump vec3 var_color;
out highp vec3 var_sc;
out mediump vec3 var_mat;
out mediump float var_bare;

#include "/builtins/materials/skinning.glsl"

void main()
{
    highp float p = floor(texcoord0.x * 2097152.0);
    highp float r = floor(p / 16384.0);
    highp float g = floor((p - r * 16384.0) / 128.0);
    highp float b = p - r * 16384.0 - g * 128.0;
    vec3 col = vec3(r, g, b) / 127.0;
    vec4 sp = get_skinned_position(position);
    vec3 sn = get_skinned_normal(normal);
    highp vec4 wp = mtx_world * vec4(sp.xyz, 1.0);
    vec3 N = normalize((mtx_normal * vec4(sn, 0.0)).xyz);
    var_mat = vec3(0.0);
    var_bare = 0.0;
    var_wpos = wp.xyz;
    var_normal = N;
    var_color = col;
    highp vec3 shp = wp.xyz + N * u_shn.x;
    var_sc = vec3(dot(u_sh0, vec4(shp, 1.0)), dot(u_sh1, vec4(shp, 1.0)), dot(u_sh2, vec4(shp, 1.0)));
    gl_Position = mtx_proj * mtx_view * wp;
}

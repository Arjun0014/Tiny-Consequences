-- Tiny Consequences render script (Stage 1.8).
-- Passes: full-screen sky gradient -> planet (terrain + sea) -> props (chunks, movers) ->
-- atmosphere rim + clouds + effects (premultiplied blending, no depth write) -> GUI.
-- Camera matrices and shader inputs come from the shared module game.view.state
-- (shared_state = 1), so there is no per-frame message traffic.
local state = require("game.view.state")

local MSG_CLEAR_COLOR = hash("clear_color")
local MSG_WINDOW_RESIZED = hash("window_resized")

-- #5FD0F0 (also what the loading screen shows behind the sky pass)
local SKY_R, SKY_G, SKY_B = 95 / 255, 208 / 255, 240 / 255

local IDENTITY = vmath.matrix4()

function init(self)
	self.pred_sky = render.predicate({ "sky" })
	self.pred_planet = render.predicate({ "planet" })
	self.pred_props = render.predicate({ "props" })
	self.pred_movers = render.predicate({ "movers" })
	self.pred_atmo = render.predicate({ "atmo" })
	self.pred_cloud = render.predicate({ "cloud" })
	self.pred_fx = render.predicate({ "fx" })
	self.pred_overlay = render.predicate({ "overlay" })
	self.pred_particle = render.predicate({ "particle" })
	self.pred_gui = render.predicate({ "gui" })
	self.pred_text = render.predicate({ "text" })
	self.pred_debug_text = render.predicate({ "debug_text" })

	self.clear_buffers = {
		[graphics.BUFFER_TYPE_COLOR0_BIT] = vmath.vector4(SKY_R, SKY_G, SKY_B, 1),
		[graphics.BUFFER_TYPE_DEPTH_BIT] = 1,
		[graphics.BUFFER_TYPE_STENCIL_BIT] = 0,
	}
	self.cb = render.constant_buffer()
	self.gui_view = vmath.matrix4()
	self.world_opts = { frustum = nil, constants = self.cb }
	-- movers in creation order (not depth-sorted) so same-buffer pool runs batch together
	self.mover_opts = { frustum = nil, constants = self.cb, sort_order = render.SORT_NONE }
	self.plain_opts = { constants = self.cb }
	self.gui_opts = {}
end

local function refresh(self)
	self.ww = render.get_window_width()
	self.wh = render.get_window_height()
	self.gui_proj = vmath.matrix4_orthographic(0, self.ww, 0, self.wh, -1, 1)
	self.gui_opts.frustum = self.gui_proj
	state.window_w, state.window_h = self.ww, self.wh
end

function update(self)
	if self.ww ~= render.get_window_width() or self.wh ~= render.get_window_height() then
		refresh(self)
	end
	if self.ww <= 0 or self.wh <= 0 then
		return
	end
	local aspect = self.ww / self.wh

	render.set_depth_mask(true)
	render.set_stencil_mask(0xff)
	render.clear(self.clear_buffers)
	render.set_viewport(0, 0, self.ww, self.wh)

	-- shader inputs
	local cb = self.cb
	state.u_sky.y = aspect
	cb.u_cam = state.u_cam
	cb.u_sun = state.u_sun
	cb.u_tex = state.u_tex
	cb.u_anim = state.u_anim
	cb.u_sky = state.u_sky
	cb.u_atmo = state.u_atmo

	-- sky (vertices already in clip space)
	render.set_view(IDENTITY)
	render.set_projection(IDENTITY)
	render.disable_state(graphics.STATE_DEPTH_TEST)
	render.set_depth_mask(false)
	render.disable_state(graphics.STATE_BLEND)
	render.disable_state(graphics.STATE_CULL_FACE)
	render.draw(self.pred_sky, self.plain_opts)

	if state.planet_on then
		local proj = vmath.matrix4_perspective(state.fov, aspect, state.near, state.far)
		state.proj = proj
		render.set_view(state.view)
		render.set_projection(proj)
		self.world_opts.frustum = proj * state.view

		-- opaque world
		render.enable_state(graphics.STATE_DEPTH_TEST)
		render.set_depth_mask(true)
		render.enable_state(graphics.STATE_CULL_FACE)
		render.set_cull_face(graphics.FACE_TYPE_BACK)
		render.draw(self.pred_planet, self.world_opts)
		render.disable_state(graphics.STATE_CULL_FACE)
		render.draw(self.pred_props, self.world_opts)
		self.mover_opts.frustum = self.world_opts.frustum
		render.draw(self.pred_movers, self.mover_opts)

		-- transparent: premultiplied alpha, depth-tested, no depth writes
		render.set_depth_mask(false)
		render.enable_state(graphics.STATE_BLEND)
		render.set_blend_func(graphics.BLEND_FACTOR_ONE, graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
		render.enable_state(graphics.STATE_CULL_FACE)
		render.set_cull_face(graphics.FACE_TYPE_BACK)
		render.draw(self.pred_atmo, self.plain_opts)
		render.draw(self.pred_cloud, self.world_opts)
		render.disable_state(graphics.STATE_CULL_FACE)
		render.draw(self.pred_fx, self.world_opts)
		render.draw(self.pred_particle, self.world_opts)
		-- selection ring: always visible on top (hidden by the view when behind the planet)
		render.disable_state(graphics.STATE_DEPTH_TEST)
		render.draw(self.pred_overlay, self.world_opts)
		render.draw_debug3d()
	end

	-- GUI
	render.disable_state(graphics.STATE_DEPTH_TEST)
	render.disable_state(graphics.STATE_CULL_FACE)
	render.enable_state(graphics.STATE_BLEND)
	render.set_blend_func(graphics.BLEND_FACTOR_SRC_ALPHA, graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
	render.set_view(self.gui_view)
	render.set_projection(self.gui_proj)
	render.enable_state(graphics.STATE_STENCIL_TEST)
	render.draw(self.pred_gui, self.gui_opts)
	render.draw(self.pred_text, self.gui_opts)
	render.draw(self.pred_debug_text, self.gui_opts)
	render.disable_state(graphics.STATE_STENCIL_TEST)
	render.disable_state(graphics.STATE_BLEND)
end

function on_message(self, message_id, message)
	if message_id == MSG_CLEAR_COLOR then
		if message.color then
			self.clear_buffers[graphics.BUFFER_TYPE_COLOR0_BIT] = message.color
		end
	elseif message_id == MSG_WINDOW_RESIZED then
		refresh(self)
	end
end

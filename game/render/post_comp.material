name: "post_comp"
tags: "post"
vertex_program: "/game/render/shaders/post.vp"
fragment_program: "/game/render/shaders/post_comp.fp"
vertex_space: VERTEX_SPACE_LOCAL
fragment_constants {
  name: "u_pdir"
  type: CONSTANT_TYPE_USER
  value {
    x: 0
    y: 0
    z: 0
    w: 0
  }
}
fragment_constants {
  name: "u_post"
  type: CONSTANT_TYPE_USER
  value {
    x: 0.6
    y: 0.25
    z: 1.08
    w: 1.04
  }
}
samplers {
  name: "tex0"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
  max_anisotropy: 1.0
}
samplers {
  name: "tex1"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
  max_anisotropy: 1.0
}
samplers {
  name: "tex2"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
  max_anisotropy: 1.0
}
max_page_count: 0

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless host: test runner, world runs, benchmarks, save inspection (D2-012). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <AssemblyName>tc2</AssemblyName>
    <NoWarn>CS1591;MSB3277;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <ProjectReference Include="../core/TC2.Core.csproj" />
    <ProjectReference Include="../tests/TC2.Tests.Core.csproj" />
    <Reference Include="nunit.framework">
      <HintPath>C:/Program Files/Unity/Hub/Editor/6000.6.4f1/Editor/Data/Resources/PackageManager/BuiltInPackages/com.unity.ext.nunit/net472/unity-custom/nunit.framework.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
